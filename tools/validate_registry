#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
registry_python="$repo_root/.venv/bin/python"

if [[ ! -x "$registry_python" ]]; then
  echo "ERROR: missing repository-local Python environment: $registry_python" >&2
  echo "Prepare it with: bash tests/bootstrap_test_environment.sh" >&2
  exit 1
fi

exec "$registry_python" "$repo_root/tools/validate_registry.py" "$@"
